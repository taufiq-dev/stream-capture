{
  // A static-assets-only Worker: no server code, no backend, nothing stored — the captured image
  // never leaves the browser. `assets.directory` is rsbuild's output, uploaded and served as-is.
  "name": "stream-capture-demo",
  "compatibility_date": "2026-09-18",
  "assets": { "directory": "./dist" }

  // Deploys run from the dashboard's Git integration, which knows which account this belongs to.
  // To deploy from your own machine instead, add
  //   "account_id": "<id from `pnpm wrangler whoami`>"
  // so it picks the right one of your two accounts without prompting. Not a secret — it is in every
  // dashboard URL — unlike an API token, which never belongs in the repo.
}
